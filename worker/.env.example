# Адрес Vercel-приложения (откуда воркер забирает job-ы).
API_BASE=https://aibooster.vercel.app

# Общий секрет воркера и Next.js API. Тот же, что WORKER_SECRET в Vercel env.
WORKER_SECRET=

# Apify — источник YouTube-транскриптов (обход YouTube anti-bot).
# Token: Apify → Settings → Integrations → API tokens.
APIFY_TOKEN=

# AI-шлюз (LLM-перевод + ElevenLabs TTS через aimlapi.com).
AIMLAPI_KEY=

# Опционально: переопределить базовый URL aimlapi.
# AIMLAPI_BASE=https://api.aimlapi.com/v1

# Cloudflare R2 (хранилище итоговых mp3).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный домен бакета (R2 → Bucket → Settings → Public access → Public Bucket URL,
# либо собственный домен). Без trailing slash.
R2_PUBLIC_BASE=https://media.example.com

# Интервал поллинга очереди (мс).
POLL_INTERVAL_MS=5000
