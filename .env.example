# AI-шлюз (один ключ на все модели: GPT/Claude/Gemini/Perplexity)
# Ключи: https://aimlapi.com/app/keys
AIMLAPI_KEY=

# Прод-БД Turso (libSQL, serverless SQLite-совместимая).
# ВАЖНО: standalone Turso DB, созданная вручную через Turso CLI/Console
# (НЕ через Vercel-Turso integration). Интеграция при любой перенастройке
# пересоздаёт БД с нуля → теряется история чатов и весь стейт.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Отдельная standalone Turso DB для бэкапов (aibooster-backup).
# Цель назначения ежедневного cron /api/admin/backup — снимок критичных
# таблиц на случай подмены/потери прод-БД.
BACKUP_DATABASE_URL=
BACKUP_AUTH_TOKEN=

# Секрет для Vercel-cron: при срабатывании cron Vercel шлёт заголовок
# Authorization: Bearer ${CRON_SECRET}. Без него крон-эндпоинт отказывает.
CRON_SECRET=

# UID владельца — единственный пользователь системы на старте.
# Используется alert-стражем в ensureSchema() (детект possible_db_swap).
OWNER_UID=

# Токен доступа к служебным эндпоинтам (/admin, /api/admin/errors,
# /api/admin/backup при ручном вызове). Без него — fail-closed.
ADMIN_TOKEN=

# Идентификатор сборки (попадает в app_errors.build). На Vercel можно
# прокинуть VERCEL_GIT_COMMIT_SHA.
BUILD_ID=dev
