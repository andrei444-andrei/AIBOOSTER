# AI-шлюз (один ключ на все модели: GPT/Claude/Gemini/Perplexity)
# Ключи: https://aimlapi.com/app/keys
AIMLAPI_KEY=

# База данных Turso (libSQL, serverless SQLite-совместимая)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Токен доступа к служебным эндпоинтам (/admin, /api/admin/errors).
# Без него админ-страница и дамп логов недоступны (никогда не публичны).
ADMIN_TOKEN=

# Идентификатор сборки (попадает в app_errors.build). На Vercel можно
# прокинуть VERCEL_GIT_COMMIT_SHA.
BUILD_ID=dev
