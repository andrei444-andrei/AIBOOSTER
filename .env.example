# AI-шлюз (один ключ на все модели: GPT/Claude/Gemini/Perplexity)
# Ключи: https://aimlapi.com/app/keys
AIMLAPI_KEY=

# База данных Turso (libSQL, serverless SQLite-совместимая)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Токен доступа к служебным эндпоинтам (/admin, /api/admin/errors).
# Без него админ-страница и дамп логов недоступны (никогда не публичны).
ADMIN_TOKEN=

# Идентификатор сборки (попадает в app_errors.build). На Vercel можно
# прокинуть VERCEL_GIT_COMMIT_SHA.
BUILD_ID=dev

# === Модуль "AI Scraper" ===
# Токен Apify (https://console.apify.com/account/integrations). НИКОГДА не
# уходит на клиент — используется только в серверных роутах.
# Это ЕДИНСТВЕННАЯ env для Apify: runner-актер создаётся и регистрируется
# в БД автоматически при первом обращении (см. lib/apify-provisioner.ts).
APIFY_TOKEN=

# --- Модуль «Адаптеры» -------------------------------------------------------

# Секрет для Vercel Cron (/api/adapters/tick). Если задан — tick принимает
# `Authorization: Bearer <CRON_SECRET>`. Если не задан — tick требует ADMIN_TOKEN.
CRON_SECRET=

# Модель для эмбеддингов context_snippets (через aimlapi.com).
EMBEDDING_MODEL=text-embedding-3-small

# OAuth (Google Mail + Calendar — один проект Google Cloud)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Notion (Internal Integration Token проще на старте; OAuth — позже)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Telegram (Bot API)
TELEGRAM_BOT_TOKEN=

# === Модуль "YouTube Translate" ===
# Секрет для эндпоинтов /api/worker/{claim,update} — на случай внешнего воркера.
# Основной пайплайн работает через Vercel Functions (/api/cron/process-jobs),
# поэтому этот секрет нужен только если когда-то подключишь сторонний worker.
WORKER_SECRET=

# Cloudflare R2 — куда складывается итоговый mp3 переведённого видео.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный домен бакета (R2 → Bucket → Settings → Public access). Без trailing slash.
R2_PUBLIC_BASE=https://media.example.com

# ID публичного YouTube-плейлиста для автоочереди переводов. Это часть URL
# после list= (например PLxyz...). Cron /api/cron/poll-playlist раз в минуту
# смотрит RSS-фид плейлиста, новые видео ставит в очередь со source=playlist
# и target_lang=ru. Если переменная не задана — фича выключена.
YOUTUBE_PLAYLIST_ID=
