# AI-шлюз (один ключ на все модели: GPT/Claude/Gemini/Perplexity/ElevenLabs).
# Ключи: https://aimlapi.com/app/keys
AIMLAPI_KEY=

# База данных Turso (libSQL, serverless SQLite-совместимая).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Токен доступа к служебным эндпоинтам (/admin, /api/admin/errors).
ADMIN_TOKEN=

# Секрет для эндпоинтов воркера (/api/worker/claim, /api/worker/update).
# Используется только если ты захочешь подключить внешний воркер; основной
# пайплайн теперь работает через /api/cron/process-jobs.
WORKER_SECRET=

# Apify token — источник YouTube-транскрипта (обход YouTube anti-bot).
# Получить: Apify → Settings → Integrations → API tokens.
APIFY_TOKEN=

# Cloudflare R2 — куда выкладываем итоговый mp3-перевод.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный домен бакета (R2 → Bucket → Settings → Public access). Без trailing slash.
R2_PUBLIC_BASE=https://media.example.com

# Vercel Cron автоматически шлёт Authorization: Bearer <CRON_SECRET>.
# Если задан — /api/cron/process-jobs проверяет совпадение. Иначе fallback
# на ADMIN_TOKEN. Удобно для ручного дёрганья при отладке.
CRON_SECRET=

# Идентификатор сборки (попадает в app_errors.build). На Vercel прокидываем
# VERCEL_GIT_COMMIT_SHA через Vercel env.
BUILD_ID=dev
